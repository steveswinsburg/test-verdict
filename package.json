{
  "name": "test-verdict",
  "version": "0.3.0",
  "description": "Universal test & code coverage PR decorator and merge gate supporting JaCoCo, Cobertura, LCOV, Istanbul/Jest, Go, and OpenCover.",
  "type": "module",
  "bin": {
    "test-verdict": "dist/cli.cjs"
  },
  "files": [
    "dist/cli.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs"
  },
  "keywords": [
    "github-actions",
    "code-coverage",
    "jacoco",
    "cobertura",
    "lcov",
    "istanbul",
    "opencover",
    "gocover",
    "pull-request",
    "ci"
  ],
  "author": "Steve Swinsburg",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steveswinsburg/test-verdict.git"
  },
  "homepage": "https://github.com/steveswinsburg/test-verdict#readme",
  "bugs": {
    "url": "https://github.com/steveswinsburg/test-verdict/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.12.1",
    "picomatch": "^4.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "yaml": "^2.7.0"
  }
}
